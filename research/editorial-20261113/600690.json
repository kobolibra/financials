    "physical_page_count": 192,
    "topics": [
      {
        "theme": "收入与分部",
        "pages": [
          151,
          171,
          172
        ],
        "finding": "主营产品收入与成本及其他业务严格闭合；经营分部含内部交易和抵销，外部收入也不等于产品主营收入。",
        "boundary": "不把两套分类混加，不用分部总成本替代营业成本。"
      },
      {
        "theme": "收入确认",
        "pages": [
          105,
          106,
          107
        ],
        "finding": "按商品与服务的履约义务及控制权转移政策阅读；管理层TC渠道改造与销量、终端需求并非同一事实。",
        "boundary": "未取得SKU销量、当地恒定汇率收入及逐合同验收记录，不做量价结构的独立归因。"
      },
      {
        "theme": "应收与保理",
        "pages": [
          117,
          118,
          119,
          123
        ],
        "finding": "净应收329.55亿元；本期因卖断保理终止确认应收58.22亿元。前五名余额按应收及合同资产总额计算占比。",
        "boundary": "存量不含已终止确认的款项；保理余额与新增现金不是同一指标。"
      },
      {
        "theme": "存货与减值",
        "pages": [
          122,
          123
        ],
        "finding": "净存货下降，跌价准备由18.98亿元升至20.54亿元，不能只凭净存货下降判断库存风险解除。",
        "boundary": "存货准备为存量，损益减值含其他资产；两者不能逐项等同。"
      },
      {
        "theme": "现金与供应商融资",
        "pages": [
          158,
          159
        ],
        "finding": "明确排除9.87亿元非现金等价物；供应商融资中的短期借款与应付账款分类、付款期限分别披露。",
        "boundary": "供应商已收款不等于公司已付款；合同安排和债务期限需分开追踪。"
      },
      {
        "theme": "外汇与对冲",
        "pages": [
          16,
          150,
          152,
          153,
          159,
          184,
          186
        ],
        "finding": "财务费用汇兑损失9.11亿元，现金汇兑影响-7.15亿元，报表折算变动进入其他综合收益。管理层另提供含套保的解释。",
        "boundary": "不把三种汇率口径直接相加；管理层剔除汇率的利润解释不是经独立识别的因果反事实。"
      },
      {
        "theme": "商誉与并表",
        "pages": [
          139,
          161,
          162
        ],
        "finding": "商誉263.35亿元；减少9.65亿元列汇率变动及其他。公司以现金流折现假设判断无需减值；报告列示本期无同控/非同控合并及处置。",
        "boundary": "预算、永续增长与折现率属估计，未做资产组独立估值，不能把无减值当作无风险。"
      },
      {
        "theme": "研发费用与资本化",
        "pages": [
          71,
          161
        ],
        "finding": "利润表研发费用50.7169亿元=费用化研发50.7064亿元+原开发支出转入损益0.0106亿元；当期资本化研发2.799亿元。",
        "boundary": "开发支出存量变化还受转无形资产和汇率影响，不可由期末减期初直接推导资本化。"
      },
      {
        "theme": "税收与非经常损益",
        "pages": [
          122,
          154,
          155,
          192
        ],
        "finding": "一次性税收调整影响5.117亿元；归母非经常净额10.175亿元，已包含所得税及少数股东影响。",
        "boundary": "税前影响、退税应收、实际收现分列；扣非并不等于剔除所有非现金费用。"
      },
      {
        "theme": "资本配置与股份支付",
        "pages": [
          150,
          151,
          182,
          183
        ],
        "finding": "本期库存股回购16.25亿元；应付普通股股利82.48亿元，期后每股分配比例因回购调整。股份支付费用合计为负。",
        "boundary": "应付股利不是当期现金分配；不能把支付股利利润和利息合计全部称为分红，也不自动将股份支付计入扣非。"
      },
      {
        "theme": "关联方与金融风险",
        "pages": [
          175,
          176,
          177,
          178,
          179,
          180,
          181,
          186
        ],
        "finding": "关联方、关联交易与集团财务公司存款风险需结合原表阅读；信用保险和额度控制是管理层风险管理措施。",
        "boundary": "有金融安排并不等于金融机构报表；公司仍以制造业口径核算，不凭管理层措施断言风险消失。"
      },
      {
        "theme": "承诺、期后与审计",
        "pages": [
          66,
          183,
          186
        ],
        "finding": "中报未经审计；报告承诺或有事项披露为无，期后披露分红实施调整；其他重要事项截至2026-08-27。",
        "boundary": "未见事项不等于未来无风险；独立人类财经/视觉二审未完成，市场估值及8–12季度历史尚未纳入本篇。"
      }
    ]
  },
