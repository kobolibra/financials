    "topics": [
      {
        "theme": "主要财务数据与调整口径",
        "pages": [
          1
        ],
        "finding": "季报首页同时列示上年同期调整前和调整后，收入、净利润、扣非与经营现金净额在调整前后相同；基本每股收益因股本变化调整前后不同。",
        "boundary": "追溯调整原因只勾选“其他原因”，没有展开。"
      },
      {
        "theme": "收入与成本",
        "pages": [
          3,
          8
        ],
        "finding": "营业收入同比+40.82%，营业成本同比+30.15%，毛利率53.05%→56.60%；管理层归因于人工智能与数据中心需求，成本增加归因于销售增长。",
        "boundary": "没有分产品、分地区数据，无法检验结构变化。"
      },
      {
        "theme": "应收款项融资与应收账款",
        "pages": [
          2,
          6
        ],
        "finding": "应收款项融资增加1.20亿元（+714%），管理层称是应收票据两期在手规模变化；应收账款增加1.20亿元。",
        "boundary": "没有票据承兑人、账龄与坏账准备明细，不能判断票据与应收的信用质量。"
      },
      {
        "theme": "预付款项与设备款",
        "pages": [
          2,
          6,
          7
        ],
        "finding": "预付款项增加0.76亿元（+365%），管理层称是预付材料款；其他非流动资产增加，管理层称是预付设备款。",
        "boundary": "没有供应商与合同明细，无法判断预付对象与交付期。"
      },
      {
        "theme": "非经常性损益",
        "pages": [
          2
        ],
        "finding": "非经常性损益净额-0.01亿元，为净损失，扣非归母净利润高于归母净利润。",
        "boundary": "按公司披露的分类使用，没有独立复核其“经常性”界定。"
      },
      {
        "theme": "现金流",
        "pages": [
          3,
          10,
          11
        ],
        "finding": "经营现金净额同比-37.92%，管理层称主要是原材料采购支出及税费支出同比增加；投资现金流出减少，管理层称是理财规模变化；筹资现金流几乎为零。",
        "boundary": "季报没有净利润到经营现金的调节表。"
      },
      {
        "theme": "汇兑",
        "pages": [
          3,
          8,
          9,
          11
        ],
        "finding": "财务费用由-0.11亿元变为0.24亿元，管理层称主要是汇兑损失；现金汇率影响-0.47亿元；外币报表折算差额-0.27亿元计入其他综合收益。",
        "boundary": "利润表没有单列汇兑损益，“利息外财务费用”由三个披露值计算得到，含汇兑与手续费等。"
      },
      {
        "theme": "跨报告期初现金差异",
        "pages": [
          11
        ],
        "finding": "本报告期初现金及现金等价物余额为29.40亿元；同一日期（2025年12月31日）在2026年三季报现金流量表第11页为28.64亿元，两者相差0.76亿元，而同一日期货币资金科目的年初数在两份报告中相差0.00亿元。",
        "boundary": "两份报告都没有说明差异原因（可能是受限资金口径调整）；三季报的数字来自按原件哈希固定的三季报账本，不属于本篇账本事实；该差异的原因为 NOT_CHECKED。"
      },
      {
        "theme": "股东与资本事项",
        "pages": [
          3,
          5
        ],
        "finding": "公司董事会与股东会审议通过发行H股并在香港联交所上市的相关议案；一季度末股本7.77亿股，第一大股东持股37.56%。",
        "boundary": "H股发行的规模、时间与募集资金用途属于其他公告，本篇没有入账；持股比例来自正文文字，未做表格源格坐标核验。"
      }
    ]
  },
