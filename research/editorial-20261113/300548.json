          107,
          108,
          135
        ],
        "finding": "电信与数通/消费/工业互联市场加其他业务构成完整收入成本；收入在某一时点确认，只有一个经营分部。",
        "boundary": "市场分类不能改写为AI、800G或1.6T独立收入；报告未提供可闭合的对应销量价格。"
      },
      {
        "theme": "应收集中与信用损失",
        "pages": [
          45,
          85,
          111,
          122
        ],
        "finding": "应收净额8.26亿元；前五大客户应收占比66.05%，上年末55.59%。信用减值损失单列。",
        "boundary": "集中不代表已经违约；需结合回款与账龄，不能以销售收现/收入比替代回收率。"
      },
      {
        "theme": "存货及跌价",
        "pages": [
          89,
          90,
          111,
          115
        ],
        "finding": "原材料等五类期末净额闭合；存货原值减跌价准备与资产负债表一致。",
        "boundary": "现金调节存货变化与净存货存量变化不同，未验证的差额不硬归因；跌价计提并不消除后续迭代风险。"
      },
      {
        "theme": "现金、冻结与理财",
        "pages": [
          83,
          115,
          116
        ],
        "finding": "货币资金与现金等价物差151533.71元；不属于现金等价物的冻结资金与存出投资款原表可核对。交易性金融资产单列。",
        "boundary": "理财不自动视作现金；账户专用、赎回条件与银行授信不是同一个流动性概念。"
      },
      {
        "theme": "现金流间接调节",
        "pages": [
          114,
          115
        ],
        "finding": "从合并净利润出发，16项原始调节精确闭合至CFO；两期分别核验。",
        "boundary": "不能用归母净利润起桥；经营性应收/应付大于单一应收账款/应付账款范围。"
      },
      {
        "theme": "少数股权与利润归属",
        "pages": [
          51,
          114,
          119,
          120
        ],
        "finding": "长芯盛持股由60.45%升至62.65%；本期投资子公司款项列其他筹资支出。合并利润中39.19%归少数股东。",
        "boundary": "期末持股比例不等于全年利润分配比例；不能用期末比例乘整个集团净利润预测归母收益。"
      },
      {
        "theme": "所得税与扣非",
        "pages": [
          8,
          82,
          112,
          143
        ],
        "finding": "税费、税收优惠及研发加计扣除在税率调节表单列；扣非归母增长94.49%。",
        "boundary": "税率变化受主体与税收优惠影响，不能将本期有效税率机械外推；扣非不等于收到现金。"
      },
      {
        "theme": "汇率与海外经营",
        "pages": [
          15,
          110,
          116,
          117,
          124
        ],
        "finding": "汇兑净损益费用0.26亿元；境外经营与外币应收应付披露。",
        "boundary": "利润表汇兑费用、现金流汇率影响与其他综合收益折算差额是三种口径，不能互换。"
      },
      {
        "theme": "研发与激励",
        "pages": [
          16,
          109,
          132,
          133
        ],
        "finding": "研发费用与研发投入披露可对应；激励费用分布于管理、研发、销售及生产。",
        "boundary": "股份支付总额2,379,502.31元与现金调节其他2,379,502.30元相差0.01元；保留原值，不强行说两者完全相等。"
      },
      {
        "theme": "商誉与并购会计",
        "pages": [
          46,
          97,
          98,
          99,
          118,
          120
        ],
        "finding": "资产负债表商誉账面额期初期末相同；控制下购买少数权益与取得新控制权区分。",
        "boundary": "账面未减少不构成经济价值未减损的独立证明；需要实际资产组测试与业绩兑现验证。"
      },
      {
        "theme": "关联方及承诺",
        "pages": [
          125,
          126,
          127,
          128,
          129,
          130,
          131,
          132,
          134
        ],
        "finding": "关联交易与往来分项披露；已签订履行中和未履行合同承诺66,743,758.49元。",
        "boundary": "关联采购销售不能全部当外部新增需求；承诺不是本期费用，也不与已付款重复累计。"
      },
      {
        "theme": "分红时点",
        "pages": [
          46,
          107
        ],
        "finding": "股东会批准现金股利85,493,392.87元；原文说明2026年7月13日派发。",
        "boundary": "批准并计入应付款不等于六月末已经现金分红，不能用拟派股利替代半年现金流表股利利息支出。"
      }
